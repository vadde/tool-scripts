# Omni-Graph Environment Configuration
# Copy this file to .env to override defaults

# Host filesystem directory to mount into container for codebase ingestion
# macOS: /Users
# Linux: /home
# Windows WSL: /mnt/c
HOST_MOUNT=/Users

# Comma-separated allowed root paths for the /api/browse directory traversal
# Defaults to /workspace and the HOST_MOUNT directory
# BROWSE_ROOTS=/workspace,/Users
